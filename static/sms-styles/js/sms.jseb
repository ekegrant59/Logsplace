import { toast } from 'https://cdn.skypack.dev/wc-toast';
// import { copyToClipboard } from 'https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/1.4.0/clipboard.min.js';

var options1 = {
    searchable: true,
    placeholder: 'Select Service'
};
var op = NiceSelect.bind(document.getElementById("service-id"), options1);

var options2 = {
    searchable: true,
    placeholder: 'Select Server'
};
var op1 = NiceSelect.bind(document.getElementById("server-id"), options2);

// Function to bind service change listener for updating total count
function bindServiceChangeListener() {
    const serviceSelect = document.querySelector('#service-id');
    if (!serviceSelect) return;

    serviceSelect.addEventListener('change', function () {
        const selected = this.options[this.selectedIndex];
        const count = selected.getAttribute('data-total-count') || 0;
        document.getElementById('count-display').textContent = count;
    });
}

$(document).ready(function () {
    $('#server-id').change(function () {
        if ($(this).val() === '') {
            $("#service-id").empty();
            $("#service-id").append("<option value=\"\">SELECT SERVICE</option>");
            if (op && op.update) {
                op.update();
                bindServiceChangeListener(); // Re-bind
            }
            return;
        }

        const token = $("#token").val();
        const params = { token: token, server: $(this).val() };
        $("#service-id").empty();
        $("#service-id").append("<option value=\"\" selected disabled>Loading.....</option>");

        $.ajax({
            type: "GET",
            url: "api/service/getService",
            data: params,
            dataType: "json",
            error: function (e) {
                console.log("AJAX error:", e);
            },
            success: function (data) {
    console.log("AJAX Success:", data);
    $("#service-id").empty();

    if (data && data.length > 0) {
        $("#service-id").append("<option value=\"\" selected disabled>Select Service</option>");

        data.forEach(service => {
            const option = `<option value="${service['project_code']}" data-price="${service['new_cost']}" data-name="${service['project_name']}" data-total-count="${service['total_count']}">${service['project_name']} - ₦${service['new_cost']}</option>`;
            $("#service-id").append(option);
        });

        if (typeof op !== 'undefined' && op.update) {
            op.update();
            bindServiceChangeListener(); // ✅ this is critical
        }
    } else {
        $("#service-id").append("<option disabled>No services available</option>");
        if (op && op.update) op.update();
    }
}

        });
    });

    $("#buy-numbers").click(function () {
        const server = $("#server-id option:selected").val();
        const service = $("#service-id option:selected").val();
        const service_price = $("#service-id option:selected").attr("data-price");
        const service_name = $("#service-id option:selected").attr("data-name");
        const token = $("#token").val();

        if (!server) {
            toast.error('Please Select Server');
            return;
        }

        if (!service) {
            toast.error('Select Service');
            return;
        }

        $('#buy-numbers').prop("disabled", true).html('<span class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 ltr:mr-1 rtl:ml-1 inline-block align-middle"></span> Finding Number...');

        const params = {
            server: server,
            service: service,
            token: token,
            service_price: service_price,
            service_name: service_name,
        };

        $.ajax({
            type: "GET",
            url: "api/service/buynumber",
            data: params,
            error: function (e) {
                console.log(e);
                toast.error('An error occurred.');
                $('#buy-numbers').html("<span class='fa fa-cart-plus' style='margin-right: 8px;'></span>Buy Number").prop("disabled", false);
            },
            success: function (data) {
                $('#buy-numbers').html("<span class='fa fa-cart-plus' style='margin-right: 8px;'></span>Buy Number").prop("disabled", false);

                try {
                    const json = JSON.parse(data);
                    if (json.status === "200") {
                        toast.success(json.message);
                        checkOrder();
                        window.location.reload();
                    } else {
                        toast.error(json.message);
                    }
                } catch (err) {
                    console.error("Invalid JSON response", err);
                    toast.error("Unexpected server response.");
                }
            }
        });
    });
});

var settime = 0;
